{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "MSBuild",
            "args": [
                "${workspaceFolder}/CamEngine.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "MSBuild",
            "args": [
                "${workspaceFolder}/CamEngine.sln",
                "/p:Configuration=Release",
                "/p:Platform=x64"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Setup Project",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/init.py"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        }
    ]
}